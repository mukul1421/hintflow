{
  "manifest_version": 3,
  "name": "HintFlow",
  "description": "Your AI coding mentor for LeetCode.",
  "version": "1.0.0",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "parser/utils.js",
        "parser/problemParser.js",
        "parser/descriptionParser.js",
        "parser/editorParser.js",
        "parser/languageParser.js",
        "parser/leetcodeParser.js",
        "ui/sidebar.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.png"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}